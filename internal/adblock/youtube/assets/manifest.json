{
  "manifest_version": 3,
  "name": "3x-ui YouTube Companion",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "description": "Client-side YouTube ad filtering and ad-player skipping. No telemetry or certificate installation.",
  "permissions": ["storage"],
  "action": {"default_popup": "popup.html"},
  "content_scripts": [
    {"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["main.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start", "world": "ISOLATED"}
  ]
}
