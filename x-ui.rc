#!/sbin/openrc-run

command="/usr/local/x-ui/x-ui"
command_background=true
pidfile="/run/x-ui.pid"
description="x-ui Service"
procname="x-ui"

depend() {
    need net
}

setup_swap() {
    mkdir -p /etc/sysctl.d
    printf 'vm.swappiness = 100\n' > /etc/sysctl.d/99-3x-ui-swap.conf 2>/dev/null || true
    printf '100\n' > /proc/sys/vm/swappiness 2>/dev/null || true

    # Reuse an existing swap device/file without changing it.
    [ "$(tail -n +2 /proc/swaps | wc -l)" -gt 0 ] && return 0

    local swapfile="/swapfile-3x-ui"
    local available_kb
    available_kb=$(df -Pk / | tail -n 1 | tr -s ' ' | cut -d ' ' -f 4)

    if [ ! -e "$swapfile" ]; then
        touch "$swapfile" || return 0
        chmod 600 "$swapfile" || return 0
        # On Btrfs this must be set before allocating extents. Harmless on
        # filesystems that do not support NOCOW.
        if command -v chattr >/dev/null 2>&1; then
            chattr +C "$swapfile" 2>/dev/null || true
        fi

        if [ "${available_kb:-0}" -ge 2097152 ]; then
            fallocate -l 1G "$swapfile" 2>/dev/null || dd if=/dev/zero of="$swapfile" bs=1M count=1024 2>/dev/null || return 0
        elif [ "${available_kb:-0}" -ge 1048576 ]; then
            fallocate -l 512M "$swapfile" 2>/dev/null || dd if=/dev/zero of="$swapfile" bs=1M count=512 2>/dev/null || return 0
        else
            rm -f "$swapfile"
            return 0
        fi

        chmod 600 "$swapfile"
        mkswap "$swapfile" >/dev/null 2>&1 || return 0
    fi

    if swapon "$swapfile" 2>/dev/null; then
        grep -q '^/swapfile-3x-ui ' /etc/fstab 2>/dev/null || printf '/swapfile-3x-ui none swap sw 0 0\n' >> /etc/fstab
    fi
    return 0
}

start_pre() {
    cd /usr/local/x-ui || return 1
    setup_swap || true
}

reload() {
    ebegin "Reloading ${RC_SVCNAME}"
    kill -USR1 $(cat $pidfile)
    eend $?
}
