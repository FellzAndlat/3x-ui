[Unit]
Description=x-ui Service
After=network.target
Wants=network.target
StartLimitIntervalSec=180
StartLimitBurst=10

[Service]
EnvironmentFile=-/etc/sysconfig/x-ui
Environment="XRAY_VMESS_AEAD_FORCED=false"
Type=simple
WorkingDirectory=/usr/local/x-ui/
ExecStart=/usr/local/x-ui/x-ui
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5s

# Keep Linux swap available and make anonymous-memory reclaim proactive.
# Existing swap is reused unchanged. Creating the managed swapfile is best
# effort, so an unsupported filesystem or a low-disk host never blocks x-ui.
ExecStartPre=-/bin/bash -c 'mkdir -p /etc/sysctl.d; printf "vm.swappiness = 100\n" > /etc/sysctl.d/99-3x-ui-swap.conf; printf "100\n" > /proc/sys/vm/swappiness; if [ "$(tail -n +2 /proc/swaps | wc -l)" -eq 0 ]; then if [ ! -e /swapfile-3x-ui ]; then touch /swapfile-3x-ui && chmod 600 /swapfile-3x-ui; if command -v chattr >/dev/null 2>&1; then chattr +C /swapfile-3x-ui 2>/dev/null || true; fi; if [ "$(df -Pk / | tail -n 1 | tr -s " " | cut -d " " -f 4)" -ge 2097152 ]; then (fallocate -l 1G /swapfile-3x-ui || dd if=/dev/zero of=/swapfile-3x-ui bs=1M count=1024 status=none) && chmod 600 /swapfile-3x-ui && mkswap /swapfile-3x-ui >/dev/null; elif [ "$(df -Pk / | tail -n 1 | tr -s " " | cut -d " " -f 4)" -ge 1048576 ]; then (fallocate -l 512M /swapfile-3x-ui || dd if=/dev/zero of=/swapfile-3x-ui bs=1M count=512 status=none) && chmod 600 /swapfile-3x-ui && mkswap /swapfile-3x-ui >/dev/null; else rm -f /swapfile-3x-ui; fi; fi; if [ -f /swapfile-3x-ui ] && swapon /swapfile-3x-ui 2>/dev/null; then grep -q "^/swapfile-3x-ui " /etc/fstab || printf "/swapfile-3x-ui none swap sw 0 0\n" >> /etc/fstab; fi; fi'

[Install]
WantedBy=multi-user.target
